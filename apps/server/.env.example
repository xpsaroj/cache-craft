# Server environment variables
## Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/cachecraft"
# separate db url for docker as localhost in container means the container itself, not the host machine
DATABASE_URL_DOCKER="postgresql://username:password@pg:5432/cachecraft"

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=cachecraft

## Server Configuration
PORT=4000

ALLOWED_ORIGINS="http://localhost:3000"

JWT_SECRET="jwt-secret-key-here"

JWT_ACCESS_TOKEN_EXPIRES_IN=15m